ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://fluctuz:fluctuz@127.0.0.1:5433/fluctuz
# Optional: tests use this server instead (needed when DATABASE_URL is a pooler such as Neon)
# TEST_DATABASE_URL=postgresql+asyncpg://fluctuz:fluctuz@127.0.0.1:5433/fluctuz
# Redis db for tests (0-15, default 15); use a different one per worktree to run tests in parallel
# TEST_REDIS_DB=15
REDIS_URL=redis://127.0.0.1:6380/0
ALLOWED_ORIGINS=http://localhost:8080
# Optional. Empty SMTP_HOST = emails are logged, not sent. Empty GOOGLE_CLIENT_ID = Google sign-in off.
# Provider: Brevo (B-056). Login and SMTP key: Brevo > Settings > SMTP & API.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Fluctuz <no-reply@fluctuz.id>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: the shared bots shown next to join codes (share links stay empty without them)
# TELEGRAM_BOT_USERNAME=FluctuzBot
# Optional: the Telegram bot for THIS environment. One bot per environment (dev, staging,
# production): a bot has one webhook, so never use the staging/production token locally.
# Local development uses your own dev bot with `python -m scripts.telegram_poll` (no secret).
# Without TELEGRAM_WEBHOOK_SECRET the webhook answers 404.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Optional: privacy policy linked from the bot's consent sentence when someone joins
# PRIVACY_POLICY_URL=https://fluctuz.id/privasi
# WHATSAPP_PUBLIC_NUMBER=6281100000000
# Optional: run background jobs in the API process instead of the worker (local quick runs)
# QUEUE_INLINE=true
# Optional: object storage for chat photos (MinIO, R2, S3). Off = files go to MEDIA_DIR on disk.
# The bucket is private; Fluctuz keys start with STORAGE_KEY_PREFIX, so a shared bucket is fine.
# STORAGE_ENABLED=true
# STORAGE_ENDPOINT_URL=https://minio.example.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_REGION=us-east-1
# STORAGE_PRESIGN_EXPIRY_SECONDS=600
# STORAGE_KEY_PREFIX=fluctuz/
# MEDIA_DIR=var/media
# Optional: speech to text for Voice Lab. "fake" (default) reads the audio as the spoken text,
# for development and tests; a cloud provider is wired in roadmap 12.7 (decision D7).
# STT_PROVIDER=fake
